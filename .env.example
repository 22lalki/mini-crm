# Postgres (Neon / Railway / local). Для Neon берите pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Telegram
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# Произвольная длинная строка. Её же Telegram присылает в X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET="change-me-long-random-string"

# Доступ в CRM
ADMIN_PASSWORD="change-me"
# Произвольная длинная строка, которой подписывается cookie сессии.
SESSION_SECRET="change-me-another-long-random-string"

# Нужен только для scripts/set-webhook.ts (например https://your-app.vercel.app)
PUBLIC_BASE_URL="https://your-app.vercel.app"

# Имя бота без @ — для ссылки в пустом состоянии списка
NEXT_PUBLIC_BOT_USERNAME="your_bot"

# Необязательно: прямое (не pooled) подключение Neon — используется только
# для миграций и сида. Если не задано, берётся DATABASE_URL.
DATABASE_URL_DIRECT=""
